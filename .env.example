# 複製為 .env，僅在本機填入。不要把 token 放進聊天或版本控制。
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=SimplesRecordResearch/0.1
MARKET_CURRENCY=USD
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 以下是開發假設，不是已核實的費率或你的實際成本。
# 依 2026-11 三筆實際 Discogs／PayPal 帳單核對：
# TOTAL_FEE_PCT：Discogs 手續費率 9%，收在商品＋向買家收取的運費。
# PAYMENT_FEE_PCT：PayPal 收款費率 4.4%，收在商品＋運費＋買家稅；PAYMENT_FIXED_TWD：每筆 US$0.30（約 NT$10）。
# CONVERSION_FEE_PCT：美元提領至台灣銀行的換匯費率 2.5%，收在扣完 Discogs 與 PayPal 後的金額。
# BUYER_TAX_PCT：買家稅率估計（美國約 8%、歐盟 VAT 20–27%；稅由 Discogs 代收代繳，不算收入）。
# BUYER_SHIPPING_TWD：向買家收取的運費（換算 TWD）；SHIPPING_COST_TWD：實際郵資。兩者相抵。
TOTAL_FEE_PCT=0.09
PAYMENT_FEE_PCT=0.044
PAYMENT_FIXED_TWD=10
CONVERSION_FEE_PCT=0.025
BUYER_TAX_PCT=0.15
BUYER_SHIPPING_TWD=0
SHIPPING_COST_TWD=600
PACKING_COST_TWD=50
RISK_RESERVE_TWD=0
MIN_MARGIN=0.15
HOT_RATIO=3
MAX_SUPPLY=3
PRICE_DROP=0.20
MIN_SCORE=60
# Google Sheets 選用：帳號金鑰 JSON 放在 secrets/，不進 git。
GOOGLE_SERVICE_ACCOUNT_FILE=
# VPS only: leave all three blank in local-only mode.
# Generate a random 32+ character admin code locally; never commit the actual code.
REMOTE_ACCESS_TOKEN=
FRONTEND_ORIGIN=
PUBLIC_API_ORIGIN=

# Optional AI listing notes; server-side only. Both required.
OPENAI_API_KEY=
OPENAI_LISTING_MODEL=

# Discogs marketplace writes stay off until this is exactly 1. Listings are created
# as Discogs drafts unless the operator picks For Sale; one attempt each, never retried.
DISCOGS_LISTING_WRITE=
# 03:00 稀缺掃描與依名單找貨（未設定時使用括號內預設）
# SCAN_MIN_WANT（50）：Want 下限；DEMAND_MIN_RATIO（2）：Want/Have 下限
# DEMAND_ALBUMS（100）：每晚最多搜尋幾張專輯；SCAN_REQUEST_BUDGET（600）：每晚 Discogs 請求上限；SCAN_MAX_NEW（150）：每晚最多新增版本
# DEMAND_MAX_FOR_SALE（10）：Discogs 在售達此數量的版本不列入每晚找貨名單
SCAN_MIN_WANT=
DEMAND_MIN_RATIO=
DEMAND_ALBUMS=
SCAN_REQUEST_BUDGET=
SCAN_MAX_NEW=
# 官方商品搜尋 API（樂天只允許後台設定的 VPS IP；值只放伺服器 .env）
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay 帳戶刪除通知（Production keyset 啟用前必須設定）：32–80 字英數／底線／連字號，與 eBay 後台填的相同；端點必須與後台登記的網址完全一致
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=https://srv1542946.hstgr.cloud/api/ebay/account-deletion
